# edge용:  cp .env.example .env   (.env는 커밋 금지)
# 이름은 docs/interface.md 7장과 같습니다.

# 노트북: ultralytics/ultralytics:8.4.198-cpu / Pi: ultralytics/ultralytics:8.4.198-arm64
EDGE_BASE=ultralytics/ultralytics:8.4.198-cpu

DEVICE_ID=pi-01
DEVICE_KEY=change-me

# 같은 PC의 server: http://host.docker.internal / EC2: http://<EC2 IP>   (끝에 / 없음)
SERVER_URL=http://host.docker.internal

# 개발: ultralytics 이미지에 들어 있는 예제 사진 / ESP32: http://<ESP32_IP>/capture
SOURCE=/ultralytics/ultralytics/assets/bus.jpg

# Pi에서 느려서 NCNN으로 변환했다면 /models/best_ncnn_model
MODEL_PATH=/models/best.pt
IMGSZ=640
CONF_TH=0.4
HEAD_RATIO=0.3
CONFIRM_FRAMES=3
REPORT_INTERVAL_S=5
FRAME_PUSH_INTERVAL_S=1
