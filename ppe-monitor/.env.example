# 복사해서 사용합니다:  cp .env.example .env   (.env는 절대 커밋 금지)
# 변수 이름은 docs/interface.md 9장과 같습니다. 이름을 바꾸지 마세요.
# 값에 $가 들어가면 반드시 작은따옴표로 감싸세요 (compose가 $를 변수로 해석함).

# ── 클라우드 (루트 docker-compose.yml) ───────────────────────────

# 로컬과 EC2 모두 :80 (HTTP). EC2 보안 그룹에서 80번을 집 IP만 허용하세요.
SITE_ADDRESS=:80

# 대시보드 로그인. 해시 생성:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<비밀번호>'
BASIC_AUTH_USER=team
BASIC_AUTH_HASH='$2a$14$여기에_생성한_해시_붙여넣기'

POSTGRES_PASSWORD=change-me
# DATABASE_URL은 docker-compose.yml이 POSTGRES_PASSWORD로 자동 구성합니다.

# device_id:key 를 쉼표로 구분. edge의 DEVICE_ID/DEVICE_KEY와 일치해야 합니다.
DEVICE_KEYS=pi-01:change-me

# 비워 두면 사진을 로컬(media 볼륨)에 저장합니다. 운영에서만 채우세요.
# AWS 키는 넣지 않습니다. EC2의 IAM 역할로 권한을 받습니다.
S3_BUCKET=
AWS_REGION=ap-northeast-2

# 대시보드 (빌드할 때 주입됨)
VITE_API_BASE=
VITE_YOUTUBE_VIDEO_ID=

# ── edge (edge/.env 로 복사해서 이 아래만 사용) ───────────────────

DEVICE_ID=pi-01
DEVICE_KEY=change-me
# 같은 PC에서 서버를 띄웠다면 http://host.docker.internal, EC2는 http://<EC2 공인 IP>. 끝에 / 없음
SERVER_URL=http://host.docker.internal
# ESP32: http://<ESP32_IP>/capture / ESP32 없이 개발할 때: /data/sample.mp4 (edge/data/에 파일 넣기)
SOURCE=/data/sample.mp4
MODEL_PATH=/models/ppe-v1.0_ncnn_model
CONF_TH=0.4
HEAD_RATIO=0.3
CONFIRM_FRAMES=3
REPORT_INTERVAL_S=5
FRAME_PUSH_INTERVAL_S=1
QUEUE_PATH=/data/queue.db
