# C1
INSPECT_WORKERS=3          # C3 레플리카 수와 같게 (더 많으면 C3 안에서 기다리다 시간 초과)
INSPECT_QUEUE=20           # 넘치면 미검사(SKIPPED)
C2_QUEUE=4                 # 넘치면 가장 오래된 프레임 폐기
TIMEOUT_C3=10              # 초, CPU 기준 (GPU면 2)

# C2
SCAN_X_RATIO=0.34
FLOW_DIRECTION=left
EDGE_MARGIN=10

# C3
SAM2_MODEL=sam2.1_hiera_tiny
DEVICE=cpu
TORCH_THREADS=3            # 코어 수 ÷ 레플리카 수. make-cert.sh가 .env를 처음 만들 때 자동으로 채움. 레플리카 수를 바꾸면 같이 변경
CIRC_THRESHOLD=0.96         # 근거: 설계 5장
SOLIDITY_THRESHOLD=0.985    # 근거: 설계 5장
