# 보드: Seeed Studio XIAO ESP32S3 Sense (ESP32-S3R8, 8MB Octal PSRAM, 8MB flash)
CONFIG_IDF_TARGET="esp32s3"

# 플래시 8MB, 앱 파티션 4MB (partitions.csv). 기본 1.5MB는 Wi-Fi 없이도 94% 사용
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM (카메라 프레임 버퍼, 모델 텐서)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 성능 (ESP-DL 공식 지연시간 수치의 기준 설정)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# XIAO는 USB-C가 내장 USB-Serial/JTAG에 연결됨 (UART0 아님)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
