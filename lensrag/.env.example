# 이 파일을 .env로 복사해서 값을 채우세요. .env는 Git에 올리지 않습니다.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# QR에 들어갈 데모 PC 주소 (localhost 금지, 같은 Wi-Fi의 LAN IP)
PUBLIC_BASE_URL=http://192.168.0.10:8000

# worker OCR 엔진: paddle | gemini | fake
OCR_ENGINE=paddle

# 개발용 스위치 (실제 시연 때는 비워두기)
RAG_MOCK=
RAG_FAKE=
